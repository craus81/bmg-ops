# BMG Ops Proof Sync — Configuration
# Copy this to .env.sync and fill in your values

# Supabase project URL (same as NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://jdwoceryzhbimjmtwrpr.supabase.co

# Supabase SERVICE ROLE key (NOT the anon key — needs storage write access)
# Find this in Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Absolute path to the proof folder on the NAS
# This is the root folder where customer proof folders live
PROOF_FOLDER=/volume1/proofs

# Storage prefix in Supabase (optional, default: nas-sync)
STORAGE_PREFIX=nas-sync
