{
  "crons": [
    {
      "path": "/api/gmail/auto-import",
      "schedule": "*/20 * * * *"
    },
    {
      "path": "/api/cron/netsuite-sync",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/parts-email-scan",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/at-risk-check",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/quote-followup-check",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/proof-reminder-check",
      "schedule": "45 13 * * *"
    },
    {
      "path": "/api/cron/stuck-vehicle-check",
      "schedule": "15 14 * * *"
    },
    {
      "path": "/api/cron/weekly-customer-digest",
      "schedule": "0 14 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
