# ─── BMG FleetSuite environment variables ───
# Copy to `.env.local` and fill in real values. Variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.
# Anything marked (required) must be set or the app will fail to boot or
# silently misbehave.

# ─── Supabase (required) ───
# Get these from the Supabase project dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Settings → Database → Connection string).
# Only needed to run database migrations: `npm run migrate`.
SUPABASE_DB_URL=

# ─── App URL (required) ───
# Used in magic-link emails and CNI invites. No trailing slash.
NEXT_PUBLIC_APP_URL=https://bmg-ops.vercel.app

# ─── NetSuite (required for accounting/quoting flows) ───
# Token-based OAuth 1.0a. Generate in NetSuite under
# Setup → Users/Roles → Access Tokens.
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
# RESTlet that returns transaction PDFs (deployed inside NetSuite).
NETSUITE_PDF_RESTLET_URL=
# RESTlet that updates item descriptions (deploy scripts/netsuite-item-restlet.js).
# Required to edit a part's description in-app and write it back to NetSuite.
NETSUITE_ITEM_RESTLET_URL=
# Executive Financials tab (Home → Financials).
# Cash / A/P / credit-card balances come from an account-search RESTlet,
# because the SuiteQL integration role can't read GL balances (it only sees
# part of the ledger). Deploy scripts/netsuite-financials-restlet.js (same as
# the item/PDF RESTlets) and set its External URL here:
NETSUITE_FINANCIALS_RESTLET_URL=
# Which accounts feed each tile — comma-separated internal IDs from the Chart
# of Accounts (Internal ID column):
#   NETSUITE_BANK_ACCOUNT_IDS → operating bank account(s)      → Cash on hand
#   NETSUITE_CARD_ACCOUNT_ID  → company credit card(s)          → Card owed
#   NETSUITE_AP_ACCOUNT_IDS   → Accounts Payable control acct   → A/P (vendor bills)
# A tile shows "—" until the RESTlet is deployed and its IDs are set; A/R
# needs neither (it reads open invoices via SuiteQL).
NETSUITE_BANK_ACCOUNT_IDS=
NETSUITE_CARD_ACCOUNT_ID=
NETSUITE_AP_ACCOUNT_IDS=

# ─── Apple Push Notifications (native iOS/iPadOS app) ───
# Token-based APNs auth. Create an APNs Auth Key (.p8) in the Apple Developer
# portal (Certificates, Identifiers & Profiles → Keys → + → Apple Push
# Notifications service). Paste the .p8 file contents into APNS_PRIVATE_KEY
# (literal newlines or \n-escaped both work).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.bmgfleet.fleetsuite

# ─── Cloudflare R2 storage (required for file uploads) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public-read CDN URL for the bucket. Used to render images/PDFs in the app.
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Email via Resend (required for invites/approvals) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=BMG Fleet

# ─── SMS via Twilio (optional — disabled if SMS_PROVIDER_ENABLED is unset) ───
SMS_PROVIDER_ENABLED=
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Set to "true" in production to enforce inbound-webhook signature checks.
TWILIO_VALIDATE_SIGNATURE=

# ─── Google APIs (optional — Gmail PO import + Calendar sync) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# The shared calendar both sides of the two-way sync use (e.g. the
# "Graphics Install Calendar" ID from Google Calendar → Settings →
# Integrate calendar). Defaults to the connected account's primary.
GOOGLE_CALENDAR_ID=

# ─── Anthropic / AI features (optional) ───
ANTHROPIC_API_KEY=

# ─── Web push notifications (optional) ───
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:ops@bmgfleet.com

# ─── Dropbox sync (optional — file mirroring for legacy workflows) ───
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ─── Cron protection ───
# Random secret used by Vercel Cron to authenticate scheduled jobs hitting
# /api/gmail/auto-import and /api/cron/netsuite-sync.
CRON_SECRET=
